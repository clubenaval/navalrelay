# Gerado automaticamente pelo NavalRelay. Não edite manualmente.
primary_hostname = relay.exemplo.com.br
spool_directory = /var/spool/exim4
pid_file_path = /run/exim4/exim.pid
log_file_path = /var/log/exim/%s.log
log_selector = +subject +smtp_confirmation +tls_cipher +delivery_size +sender_on_delivery
log_timezone = true
message_logs = false
host_lookup = *
rfc1413_query_timeout = 0s
never_users = root
local_interfaces = <; 0.0.0.0 ; ::0
daemon_smtp_ports = 25 : 587
domainlist local_domains = @
hostlist relay_from_hosts = <; 127.0.0.1 ; ::1 ; 10.0.0.0/8 ; 192.168.0.0/16
hostlist docker_gateways = <; 172.18.0.1 ; fd00::1
acl_smtp_mail = acl_check_mail
acl_smtp_rcpt = acl_check_rcpt
message_size_limit = 25M
smtp_accept_max = 200
smtp_accept_max_per_host = 50
smtp_banner = $smtp_active_hostname ESMTP NavalRelay
ignore_bounce_errors_after = 2d
timeout_frozen_after = 7d
tls_advertise_hosts = *
tls_certificate = /etc/exim4/tls/cert.pem
tls_privatekey = /etc/exim4/tls/key.pem

begin acl

acl_check_mail:
  deny    message = Connection through Docker gateway refused (source IP masked); connect using the server IP address instead of localhost
          hosts = +docker_gateways
  deny    message = Relay not permitted
          !hosts = +relay_from_hosts
  accept  senders = :
  deny    message = Sender domain not allowed: $sender_address_domain
          condition = ${if inlist{${lc:$sender_address_domain}}{<; exemplo.com.br ; filial.exemplo.com.br}{no}{yes}}
  accept

acl_check_rcpt:
  accept  hosts = +relay_from_hosts
  deny    message = Relay not permitted

begin routers

dnslookup:
  driver = dnslookup
  domains = ! +local_domains
  transport = remote_smtp
  ignore_target_hosts = <; 0.0.0.0 ; 127.0.0.0/8 ; ::1
  no_more

begin transports

remote_smtp:
  driver = smtp
  dkim_domain = ${if inlist{${lc:${domain:$h_from:}}}{<; exemplo.com.br ; filial.exemplo.com.br}{${lc:${domain:$h_from:}}}{}}
  dkim_selector = dkim
  dkim_private_key = ${lookup{$dkim_domain}lsearch{/etc/exim4/dkim/map}}
  dkim_canon = relaxed


begin retry

* * F,2h,15m; G,16h,1h,1.5; F,4d,6h
